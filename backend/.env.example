# Credentials: set ANTHROPIC_API_KEY, or leave it unset and run `ant auth login`.
ANTHROPIC_API_KEY=
# Optional: OpenAI, for agents set to OpenAI (or everything, with AGENT_DEFAULT_PROVIDER=openai)
OPENAI_API_KEY=
AGENT_OPENAI_MODEL=gpt-5
AGENT_DEFAULT_PROVIDER=anthropic

# Agent settings (all optional - defaults shown)
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=high
AGENT_MAX_TOKENS=64000
AGENT_MAX_ITERATIONS=25
AGENT_ENABLE_WEB_TOOLS=true
AGENT_ENABLE_FALLBACKS=true

# Storage
AGENT_DATA_DIR=./data
AGENT_WORKSPACE_DIR=./workspace

# Comma-separated origins allowed to call the API
AGENT_CORS_ORIGINS=http://localhost:4200

# Accounts (the first account to sign up becomes admin)
AGENT_ALLOW_SIGNUP=true
AGENT_LOGIN_DAYS=7
# Set to true when serving over HTTPS
AGENT_COOKIE_SECURE=false

# Password reset emails. Without AGENT_SMTP_HOST the reset link is printed in the backend log.
AGENT_APP_URL=http://localhost:4200
AGENT_RESET_MINUTES=30
AGENT_SMTP_HOST=
AGENT_SMTP_PORT=587
AGENT_SMTP_USER=
AGENT_SMTP_PASSWORD=
AGENT_SMTP_FROM=Synora <no-reply@localhost>
