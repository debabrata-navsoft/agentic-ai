# Credentials: set ANTHROPIC_API_KEY, or leave it unset and run `ant auth login`.
ANTHROPIC_API_KEY=

# Agent settings (all optional - defaults shown)
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=high
AGENT_MAX_TOKENS=64000
AGENT_MAX_ITERATIONS=25
AGENT_ENABLE_WEB_TOOLS=true
AGENT_ENABLE_FALLBACKS=true

# Storage
AGENT_DATA_DIR=./data
AGENT_WORKSPACE_DIR=./workspace

# Comma-separated origins allowed to call the API
AGENT_CORS_ORIGINS=http://localhost:4200
